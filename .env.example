# ==========================================
# 1. POWIADOMIENIA (DISCORD)
# ==========================================
# Webhook do automatycznych powiadomień w GitHub Actions / CLI:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# (Opcjonalnie) Token bota Discorda do interaktywnych komend (/list, /raport, /oferty):
# Pobierz z https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ==========================================
# 2. ALTERNATYWNY KANAŁ (TELEGRAM)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 3. AI SCREENING ENGINE (GEMINI)
# ==========================================
# Klucz z https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# 4. PARAMETRY WYSZUKIWANIA
# ==========================================
TARGET_KEYWORDS=python
TARGET_SENIORITY=trainee,junior
TARGET_CATEGORY=backend
