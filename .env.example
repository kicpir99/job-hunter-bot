# ==========================================
# 1. KANAŁ POWIADOMIEŃ (Wybierz Discord LUB Telegram)
# ==========================================

# Opcja A: Discord Webhook (Najprostsza opcja - 1 link, bez rejestracji botów!)
# Instrukcja: Ustawienia kanału na Discordzie -> Integracje -> Webhooki -> Nowy Webhook -> Kopiuj adres URL webhooka
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/twoj_webhook_tutaj

# Opcja B: Telegram (Alternatywa)
# Uzyskaj token od @BotFather oraz ID z @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 2. GEMINI AI (Opcjonalny filtr i podsumowanie)
# ==========================================
# Darmowy klucz z: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ==========================================
# 3. KRYTERIA WYSZUKIWANIA
# ==========================================
TARGET_KEYWORDS=python
TARGET_SENIORITY=trainee,junior
TARGET_CATEGORY=backend
